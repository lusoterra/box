[Desktop Entry]
Type=Application
Version=1.0
Name=Box
GenericName=Booru Client
Comment=Booru client for local archives and online boorus
Exec=box %F
# Unique icon key: stock themes already ship a generic "box" action icon
# that would shadow ours in lookup.
Icon=booru-explorer
Terminal=false
Categories=Graphics;Viewer;
MimeType=inode/directory;
StartupWMClass=box
